{
  "manifest_version": 3,
  "name": "Alphacoders Instant Download",
  "description": "Instantly download any Alphacoders image from free download buttons across the site.",
  "version": "1.0.0",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.alphacoders.com/*"
  ],
  "action": {
    "default_title": "Alphacoders Instant Download",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.alphacoders.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
